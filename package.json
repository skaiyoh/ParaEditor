{
  "name": "noisy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.4.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.test.json",
    "test": "node --test --test-timeout=60000 \"test/**/*.test.ts\"",
    "test:browser": "npm run build && npm run build:production && node tools/drive-chrome.mjs",
    "build": "node tools/build.mjs --mode dev",
    "build:production": "node tools/build.mjs --mode production",
    "serve": "node tools/serve.mjs --mode dev",
    "start": "node tools/start.mjs",
    "check:headers": "node tools/check-headers.mjs"
  },
  "dependencies": {
    "mediabunny": "1.60.0",
    "onnxruntime-web": "1.30.0",
    "preact": "10.29.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "25.9.8",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "esbuild": false,
    "protobufjs": false
  }
}
