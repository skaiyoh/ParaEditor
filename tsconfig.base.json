{
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "module": "preserve",
    "moduleResolution": "bundler",
    "target": "es2024",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "types": [],
    "skipLibCheck": true
  }
}
